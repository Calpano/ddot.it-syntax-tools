<lexer>
  <!--
    Chroma lexer for ddot.it (https://ddot.it).
    Port of the Pygments lexer (../pygments/pygments_ddot/lexer.py) and the
    Rouge lexer (../rouge/lib/rouge/lexers/ddot.rb), adapted for Chroma's
    one-mutator-per-rule restriction. Where the others use pop+push as a
    "goto" between phase states, this lexer uses push-only nesting, with each
    non-root state carrying a `(?=\n)` rule that pops one. On end-of-line the
    pops cascade until we are back in root, which then consumes the `\n`.

    That cascade is also how a !!block returns: `verbatim` pops ONE level on
    its terminating blank line and deliberately does NOT consume the newline,
    so the pops carry on up to root regardless of which slot opened the block.

    `!!block?end=MARKER` needs a terminator equal to text captured EARLIER, and
    Chroma XML has no callbacks or state variables, so no per-line rule can refer
    back to it. It is handled instead by matching the WHOLE construct — opener,
    body and terminator — in a single rule: Chroma compiles with regexp2, which
    supports backreferences, and `bygroups` colours the parts. The groups must
    TILE the match, because bygroups silently drops matched text that no group
    covers. Corpus case 21-block-end-marker; the blank-line form (17, 29, 30) is
    still handled per-line by the `verbatim` state.

    Token mapping (Chroma → canonical, see ../../ddot.it/test-data/tokens.md):
      NameClass             → subject
      NameFunction          → relation
      LiteralStringSymbol   → object
      Operator              → doubledot
      KeywordPseudo         → command
      CommentPreproc        → meta-delim
      Punctuation           → meta-separator
      CommentHashbang       → meta-doubledot
      NameAttribute         → meta-relation
      LiteralStringHeredoc  → meta-object
      CommentMultiline      → meta-text
      CommentSingle         → excluded
      LiteralStringBacktick → verbatim
  -->
  <config>
    <name>ddot.it</name>
    <alias>ddot</alias>
    <alias>ddotit</alias>
    <alias>ddot.it</alias>
    <filename>*.ddot</filename>
    <mime_type>text/x-ddot</mime_type>
  </config>
  <rules>
    <!--
      Lexical tokens: runs of EXACTLY n, neither preceded nor followed by the
      same character. regexp2 (which Chroma uses) supports the lookarounds that
      express this; plain `\.{2}` would match the first two dots of `...`.
        DT2  (?<!\.)\.{2}(?!\.)
        QUAD (?<!\.)(?:\.{4}|\.{2}[\t\p{Zs}]+\.{2})(?!\.)
        CM2  (?<!,),,(?!,)
        SC2  (?<!;);;(?!;)
      GATE: a line is ddot.it only with a full operator skeleton — two DT2, or
      one DT4 / '.. ..'. A lone `..` in prose does not qualify (23-not-a-triple).
    -->
    <state name="root">
      <!-- Standalone `,,` opens a free-form meta block. -->
      <rule pattern="^[\t\p{Zs}]*(?&lt;!,),,(?!,)[\t\p{Zs}]*(?=\n|$)">
        <token type="CommentPreproc"/>
        <push state="meta_block"/>
      </rule>
      <!-- Parse Spec "block-continuation": after a block that filled the OBJECT, a
           line whose first token is CM2 CONTINUES the logical line as metadata; it is
           NOT a fresh triple with the subject ",,". Keyed on shape (",," then
           whitespace then ".."), because a per-line state machine cannot see the
           preceding block. Corpus case 32-chained-blocks. -->
      <rule pattern="^[\t\p{Zs}]*((?&lt;!,),,(?!,))(?=[\t\p{Zs}]+(?&lt;!\.)\.{2}(?!\.))">
        <bygroups>
          <token type="CommentPreproc"/>
        </bygroups>
        <push state="inline_meta"/>
      </rule>
      <!-- ... and SC2 after a block META OBJECT (`;; ..until.. 2020`). -->
      <rule pattern="^[\t\p{Zs}]*((?&lt;!;);;(?!;))(?=[\t\p{Zs}]+(?&lt;!\.)\.{2}(?!\.))">
        <bygroups>
          <token type="Punctuation"/>
        </bygroups>
        <push state="inline_meta"/>
      </rule>
      <!-- Off marker enters an excluded span. -->
      <!-- Recognised ANYWHERE on the line (host-language comments); the whole line
           is consumed, but only the command itself is coloured. -->
      <rule pattern="^([^\n]*?)((?:ddot\.it/off|!!off)(?![^\t\p{Zs}\r\n\f\v?#]))([^\n]*)(?=\n|$)">
        <bygroups>
          <token type="Text"/>
          <token type="KeywordPseudo"/>
          <token type="Text"/>
        </bygroups>
        <push state="disabled"/>
      </rule>
      <!-- `!!block?end=MARKER`: the terminator repeats text captured EARLIER, which
           no per-line rule can refer back to. Chroma compiles with regexp2, so the
           whole construct — opener, body and terminator — is matched by ONE regex
           using a backreference, and coloured with bygroups. -->
      <rule pattern="^([\t\p{Zs}]*)((?:(?:https?://)?ddot\.it/|!!)block)(\?end=)([^\t\p{Zs}\r\n\f\v]+)([\t\p{Zs}]*\n)((?:[^\n]*\n)*?)([\t\p{Zs}]*)(\4)([\t\p{Zs}]*)(?=\n|$)">
        <bygroups>
          <token type="Text"/>
          <token type="KeywordPseudo"/>
          <token type="NameDecorator"/>
          <token type="NameLabel"/>
          <token type="Text"/>
          <token type="LiteralStringBacktick"/>
          <token type="Text"/>
          <token type="NameLabel"/>
          <token type="Text"/>
        </bygroups>
      </rule>
      <!-- `!!block` alone on a line = a SUBJECT opener (block-as-field). -->
      <rule pattern="^[\t\p{Zs}]*(?:(?:https?://)?ddot\.it/|!!)block[\t\p{Zs}]*(?=\n|$)">
        <token type="KeywordPseudo"/>
        <push state="verbatim"/>
      </rule>
      <!-- Empty / whitespace-only line. -->
      <rule pattern="^[\t\p{Zs}]*\n">
        <token type="Text"/>
      </rule>
      <!-- Residual `\n` after the cascade has popped phase states. -->
      <rule pattern="\n">
        <token type="Text"/>
      </rule>
      <!-- Gated continuation line (starts with the operator). -->
      <rule pattern="^(?=[^\n]*(?:(?&lt;!\.)\.{4}(?!\.)|(?&lt;!\.)\.{2}(?!\.)[^\n]*(?&lt;!\.)\.{2}(?!\.)))(?=[\t\p{Zs}]*(?:(?&lt;!\.)\.{2}(?!\.)|(?&lt;!\.)(?:\.{4}|\.{2}[\t\p{Zs}]+\.{2})(?!\.)))">
        <push state="after_subject"/>
      </rule>
      <!-- Gated triple line. -->
      <rule pattern="^(?=[^\n]*(?:(?&lt;!\.)\.{4}(?!\.)|(?&lt;!\.)\.{2}(?!\.)[^\n]*(?&lt;!\.)\.{2}(?!\.)))">
        <push state="subject"/>
      </rule>
      <!-- Not a triple: consume the line, emit no ddot.it token. -->
      <rule pattern="[^\n]+">
        <token type="Text"/>
      </rule>
    </state>

    <!-- A !!block body. Pops ONE level on the blank line WITHOUT consuming the
         newline, so root's cascade carries us the rest of the way back. -->
    <state name="verbatim">
      <rule pattern="^[\t\p{Zs}]*(?=\n|$)">
        <token type="Text"/>
        <pop depth="1"/>
      </rule>
      <rule pattern="^[^\n]+">
        <token type="LiteralStringBacktick"/>
      </rule>
      <rule pattern="\n">
        <token type="Text"/>
      </rule>
    </state>

    <state name="disabled">
      <rule pattern="^([^\n]*?)((?:ddot\.it/on|!!on)(?![^\t\p{Zs}\r\n\f\v?#]))([^\n]*)(?=\n|$)">
        <bygroups>
          <token type="Text"/>
          <token type="KeywordPseudo"/>
          <token type="Text"/>
        </bygroups>
        <pop depth="1"/>
      </rule>
      <rule pattern="^[\t\p{Zs}]*\n">
        <token type="Text"/>
      </rule>
      <rule pattern="[^\n]+">
        <token type="CommentSingle"/>
      </rule>
      <rule pattern="\n">
        <token type="Text"/>
      </rule>
    </state>

    <state name="meta_block">
      <rule pattern="^[\t\p{Zs}]*(?&lt;!,),,(?!,)[\t\p{Zs}]*(?=\n|$)">
        <token type="CommentPreproc"/>
        <pop depth="1"/>
      </rule>
      <rule pattern="^[\t\p{Zs}]*\n">
        <token type="Text"/>
      </rule>
      <rule pattern="^(?=[\t\p{Zs}]*(?:(?&lt;!\.)\.{2}(?!\.)|(?&lt;!\.)(?:\.{4}|\.{2}[\t\p{Zs}]+\.{2})(?!\.)))">
        <push state="typed_meta_op"/>
      </rule>
      <rule pattern="[^\n]+">
        <token type="CommentMultiline"/>
      </rule>
      <rule pattern="\n">
        <token type="Text"/>
      </rule>
    </state>

    <state name="subject">
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <!-- A slot whose text is exactly a command is a command, not a subject. -->
      <rule pattern="(?:(?:https?://)?ddot\.it/|!!)[^\t\p{Zs}\r\n\f\v?#]+(?:\?[^\t\p{Zs}\r\n\f\v#]*)?(?:\#[^\t\p{Zs}\r\n\f\v]*)?(?=[\t\p{Zs}]*(?:(?&lt;!\.)\.{2}(?!\.)|(?&lt;!\.)(?:\.{4}|\.{2}[\t\p{Zs}]+\.{2})(?!\.))|[\t\p{Zs}]*(?&lt;!,),,(?!,)|[\t\p{Zs}]*$|\n|$)">
        <token type="KeywordPseudo"/>
        <push state="after_subject"/>
      </rule>
      <rule pattern="[^\t\p{Zs}\r\n\f\v.,][^\n,]*?(?=[\t\p{Zs}]*(?:(?&lt;!\.)\.{2}(?!\.)|(?&lt;!\.)(?:\.{4}|\.{2}[\t\p{Zs}]+\.{2})(?!\.))|[\t\p{Zs}]*(?&lt;!,),,(?!,)|[\t\p{Zs}]*$|\n|$)">
        <token type="NameClass"/>
        <push state="after_subject"/>
      </rule>
      <rule pattern="(?=\n)">
        <pop depth="1"/>
      </rule>
    </state>

    <state name="after_subject">
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <!-- QuadDot FIRST: '.. ..' is ONE operator, not two. -->
      <rule pattern="(?&lt;!\.)(?:\.{4}|\.{2}[\t\p{Zs}]+\.{2})(?!\.)">
        <token type="Operator"/>
        <push state="object"/>
      </rule>
      <rule pattern="(?&lt;!\.)\.{2}(?!\.)">
        <token type="Operator"/>
        <push state="relation"/>
      </rule>
      <rule pattern="(?&lt;!,),,(?!,)">
        <token type="CommentPreproc"/>
        <push state="inline_meta"/>
      </rule>
      <rule pattern="(?=\n)">
        <pop depth="1"/>
      </rule>
    </state>

    <state name="relation">
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <rule pattern="(?:(?:https?://)?ddot\.it/|!!)[^\t\p{Zs}\r\n\f\v?#]+(?:\?[^\t\p{Zs}\r\n\f\v#]*)?(?:\#[^\t\p{Zs}\r\n\f\v]*)?(?=[\t\p{Zs}]*(?&lt;!\.)\.{2}(?!\.)|[\t\p{Zs}]*$|\n|$)">
        <token type="KeywordPseudo"/>
        <push state="after_relation"/>
      </rule>
      <rule pattern="[^\t\p{Zs}\r\n\f\v.,][^\n.,]*?(?=[\t\p{Zs}]*(?&lt;!\.)\.{2}(?!\.)|[\t\p{Zs}]*$|\n|$)">
        <token type="NameFunction"/>
        <push state="after_relation"/>
      </rule>
      <rule pattern="(?=\n)">
        <pop depth="1"/>
      </rule>
    </state>

    <state name="after_relation">
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <rule pattern="(?&lt;!\.)\.{2}(?!\.)">
        <token type="Operator"/>
        <push state="object"/>
      </rule>
      <rule pattern="(?&lt;!,),,(?!,)">
        <token type="CommentPreproc"/>
        <push state="inline_meta"/>
      </rule>
      <rule pattern="(?=\n)">
        <pop depth="1"/>
      </rule>
    </state>

    <!-- Object := TextExcept{NL,CM2} — it MAY contain `..` (20-object-dotdot),
         so it runs to end of line or to a `,,`, never stopping at a DT2. -->
    <state name="object">
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <!-- `!!block?end=MARKER`: the terminator repeats text captured EARLIER, which
           no per-line rule can refer back to. Chroma compiles with regexp2, so the
           whole construct — opener, body and terminator — is matched by ONE regex
           using a backreference, and coloured with bygroups. -->
      <rule pattern="((?:(?:https?://)?ddot\.it/|!!)block)(\?end=)([^\t\p{Zs}\r\n\f\v]+)([\t\p{Zs}]*\n)((?:[^\n]*\n)*?)([\t\p{Zs}]*)(\3)([\t\p{Zs}]*)(?=\n|$)">
        <bygroups>
          <token type="KeywordPseudo"/>
          <token type="NameDecorator"/>
          <token type="NameLabel"/>
          <token type="Text"/>
          <token type="LiteralStringBacktick"/>
          <token type="Text"/>
          <token type="NameLabel"/>
          <token type="Text"/>
        </bygroups>
      </rule>
      <rule pattern="(?:(?:https?://)?ddot\.it/|!!)block[\t\p{Zs}]*(?=\n|$)">
        <token type="KeywordPseudo"/>
        <push state="verbatim"/>
      </rule>
      <rule pattern="(?:(?:https?://)?ddot\.it/|!!)[^\t\p{Zs}\r\n\f\v?#]+(?:\?[^\t\p{Zs}\r\n\f\v#]*)?(?:\#[^\t\p{Zs}\r\n\f\v]*)?(?=[\t\p{Zs}]*(?&lt;!,),,(?!,)|[\t\p{Zs}]*$|\n|$)">
        <token type="KeywordPseudo"/>
        <push state="after_object"/>
      </rule>
      <rule pattern="[^\t\p{Zs}\r\n\f\v,][^\n,]*?(?=[\t\p{Zs}]*(?&lt;!,),,(?!,)|[\t\p{Zs}]*$|\n|$)">
        <token type="LiteralStringSymbol"/>
        <push state="after_object"/>
      </rule>
      <rule pattern="(?=\n)">
        <pop depth="1"/>
      </rule>
    </state>

    <state name="after_object">
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <rule pattern="(?&lt;!,),,(?!,)(?=[\t\p{Zs}]*(?:\n|$))">
        <token type="CommentPreproc"/>
        <push state="meta_block_open"/>
      </rule>
      <rule pattern="(?&lt;!,),,(?!,)">
        <token type="CommentPreproc"/>
        <push state="inline_meta"/>
      </rule>
      <rule pattern="(?=\n)">
        <pop depth="1"/>
      </rule>
    </state>

    <!-- After a trailing `,,`: consume the newline and enter the block form.
         Consuming (rather than popping) is the only way to change state here,
         given one mutator per rule. -->
    <state name="meta_block_open">
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <rule pattern="\n">
        <token type="Text"/>
        <push state="typed_meta_block"/>
      </rule>
    </state>

    <!-- Same rules as `meta_block`, but reached via `meta_block_open`, so the
         closing `,,` must pop BOTH (depth 2) to get back to the triple line's
         states; the `(?=\n)` cascade then returns to root. Popping only one
         would leave `meta_block_open` on the stack, and it would re-push this
         state on the next newline. -->
    <state name="typed_meta_block">
      <rule pattern="^[\t\p{Zs}]*(?&lt;!,),,(?!,)[\t\p{Zs}]*(?=\n|$)">
        <token type="CommentPreproc"/>
        <pop depth="2"/>
      </rule>
      <rule pattern="^[\t\p{Zs}]*\n">
        <token type="Text"/>
      </rule>
      <rule pattern="^(?=[\t\p{Zs}]*(?:(?&lt;!\.)\.{2}(?!\.)|(?&lt;!\.)(?:\.{4}|\.{2}[\t\p{Zs}]+\.{2})(?!\.)))">
        <push state="typed_meta_op"/>
      </rule>
      <rule pattern="[^\n]+">
        <token type="CommentMultiline"/>
      </rule>
      <rule pattern="\n">
        <token type="Text"/>
      </rule>
    </state>

    <state name="typed_meta_op">
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <rule pattern="(?&lt;!\.)(?:\.{4}|\.{2}[\t\p{Zs}]+\.{2})(?!\.)">
        <token type="CommentHashbang"/>
        <push state="typed_meta_object"/>
      </rule>
      <rule pattern="(?&lt;!\.)\.{2}(?!\.)">
        <token type="CommentHashbang"/>
        <push state="typed_meta_relation"/>
      </rule>
      <rule pattern="(?=\n)">
        <pop depth="1"/>
      </rule>
    </state>

    <state name="typed_meta_relation">
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <rule pattern="(?:(?:https?://)?ddot\.it/|!!)[^\t\p{Zs}\r\n\f\v?#]+(?:\?[^\t\p{Zs}\r\n\f\v#]*)?(?:\#[^\t\p{Zs}\r\n\f\v]*)?(?=[\t\p{Zs}]*(?&lt;!\.)\.{2}(?!\.)|[\t\p{Zs}]*$|\n|$)">
        <token type="KeywordPseudo"/>
        <push state="typed_meta_after_relation"/>
      </rule>
      <rule pattern="[^\t\p{Zs}\r\n\f\v.,][^\n.,]*?(?=[\t\p{Zs}]*(?&lt;!\.)\.{2}(?!\.)|[\t\p{Zs}]*$|\n|$)">
        <token type="NameAttribute"/>
        <push state="typed_meta_after_relation"/>
      </rule>
      <rule pattern="(?=\n)">
        <pop depth="1"/>
      </rule>
    </state>

    <state name="typed_meta_after_relation">
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <rule pattern="(?&lt;!\.)\.{2}(?!\.)">
        <token type="CommentHashbang"/>
        <push state="typed_meta_object"/>
      </rule>
      <rule pattern="(?=\n)">
        <pop depth="1"/>
      </rule>
    </state>

    <!-- MetaObjectInBlock := TextExcept{NL} — `;;` is CONTENT here, not a
         separator (that is the inline form). See 28-semicolon-in-meta-block. -->
    <state name="typed_meta_object">
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <!-- `!!block?end=MARKER`: the terminator repeats text captured EARLIER, which
           no per-line rule can refer back to. Chroma compiles with regexp2, so the
           whole construct — opener, body and terminator — is matched by ONE regex
           using a backreference, and coloured with bygroups. -->
      <rule pattern="((?:(?:https?://)?ddot\.it/|!!)block)(\?end=)([^\t\p{Zs}\r\n\f\v]+)([\t\p{Zs}]*\n)((?:[^\n]*\n)*?)([\t\p{Zs}]*)(\3)([\t\p{Zs}]*)(?=\n|$)">
        <bygroups>
          <token type="KeywordPseudo"/>
          <token type="NameDecorator"/>
          <token type="NameLabel"/>
          <token type="Text"/>
          <token type="LiteralStringBacktick"/>
          <token type="Text"/>
          <token type="NameLabel"/>
          <token type="Text"/>
        </bygroups>
      </rule>
      <rule pattern="(?:(?:https?://)?ddot\.it/|!!)block[\t\p{Zs}]*(?=\n|$)">
        <token type="KeywordPseudo"/>
        <push state="verbatim"/>
      </rule>
      <rule pattern="[^\t\p{Zs}\r\n\f\v][^\n]*?(?=[\t\p{Zs}]*$|\n|$)">
        <token type="LiteralStringHeredoc"/>
        <push state="typed_meta_after_object"/>
      </rule>
      <rule pattern="(?=\n)">
        <pop depth="1"/>
      </rule>
    </state>

    <state name="typed_meta_after_object">
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <rule pattern="(?=\n)">
        <pop depth="1"/>
      </rule>
    </state>

    <state name="inline_meta">
      <!-- A COMPLETE `..rel.. value` right after the `,,` selects the pair form.
           A lone `..` before the entry ends (at `;;` or EOL) is not an operator, it is
           literal meta text (41-inline-meta-unclosed-pair). The inner class excludes
           SC2 so this cannot borrow the `..` of the NEXT entry. -->
      <rule pattern="(?=[\t\p{Zs}]*(?:(?&lt;!\.)(?:\.{4}|\.{2}[\t\p{Zs}]+\.{2})(?!\.)|(?&lt;!\.)\.{2}(?!\.)(?:(?!(?&lt;!\.)\.{2}(?!\.))(?!(?&lt;!;);;(?!;))[^\n])*?(?&lt;!\.)\.{2}(?!\.)))">
        <push state="inline_meta_op"/>
      </rule>
      <!-- An entry may be EMPTY and still be separated: `,, ;; a note`, and a trailing
           `,, ;;` (40-inline-meta-empty-entry). `;;` separates unconditionally, so it is
           a separator here too, not meta text. -->
      <rule pattern="(?&lt;!;);;(?!;)">
        <token type="Punctuation"/>
      </rule>
      <!-- block-as-field's 4th position: a `!!block` that fills the whole meta
           TEXT. Must precede the free-text rule, which would otherwise swallow
           the opener. Same two shapes as in `object`. -->
      <rule pattern="((?:(?:https?://)?ddot\.it/|!!)block)(\?end=)([^\t\p{Zs}\r\n\f\v]+)([\t\p{Zs}]*\n)((?:[^\n]*\n)*?)([\t\p{Zs}]*)(\3)([\t\p{Zs}]*)(?=\n|$)">
        <bygroups>
          <token type="KeywordPseudo"/>
          <token type="NameDecorator"/>
          <token type="NameLabel"/>
          <token type="Text"/>
          <token type="LiteralStringBacktick"/>
          <token type="Text"/>
          <token type="NameLabel"/>
          <token type="Text"/>
        </bygroups>
      </rule>
      <rule pattern="(?:(?:https?://)?ddot\.it/|!!)block[\t\p{Zs}]*(?=\n|$)">
        <token type="KeywordPseudo"/>
        <push state="verbatim"/>
      </rule>
      <!-- …anything else is free-form meta text, trimmed of surrounding WS.
           MetaTextInline := TextExcept{NL,SC2}: the note ENDS at the next `;;`,
           exactly as a pair's object does — `;;` separates entries unconditionally
           (36-inline-meta-notes, 37-inline-meta-mixed). -->
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <rule pattern="(?!(?&lt;!;);;(?!;))[^\t\p{Zs}\r\n\f\v](?:(?!(?&lt;!;);;(?!;))[^\n])*?(?=[\t\p{Zs}]*(?&lt;!;);;(?!;)|[\t\p{Zs}]*$|\n|$)">
        <token type="CommentMultiline"/>
        <push state="inline_meta_next"/>
      </rule>
      <rule pattern="(?=\n)">
        <pop depth="1"/>
      </rule>
    </state>

    <state name="inline_meta_op">
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <rule pattern="(?&lt;!\.)(?:\.{4}|\.{2}[\t\p{Zs}]+\.{2})(?!\.)">
        <token type="CommentHashbang"/>
        <push state="inline_meta_object"/>
      </rule>
      <rule pattern="(?&lt;!\.)\.{2}(?!\.)">
        <token type="CommentHashbang"/>
        <push state="inline_meta_relation"/>
      </rule>
      <rule pattern="(?=\n)">
        <pop depth="1"/>
      </rule>
    </state>

    <state name="inline_meta_relation">
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <rule pattern="(?:(?:https?://)?ddot\.it/|!!)[^\t\p{Zs}\r\n\f\v?#]+(?:\?[^\t\p{Zs}\r\n\f\v#]*)?(?:\#[^\t\p{Zs}\r\n\f\v]*)?(?=[\t\p{Zs}]*(?&lt;!\.)\.{2}(?!\.)|[\t\p{Zs}]*$|\n|$)">
        <token type="KeywordPseudo"/>
        <push state="inline_meta_after_relation"/>
      </rule>
      <rule pattern="[^\t\p{Zs}\r\n\f\v.,][^\n.,]*?(?=[\t\p{Zs}]*(?&lt;!\.)\.{2}(?!\.)|[\t\p{Zs}]*$|\n|$)">
        <token type="NameAttribute"/>
        <push state="inline_meta_after_relation"/>
      </rule>
      <rule pattern="(?=\n)">
        <pop depth="1"/>
      </rule>
    </state>

    <state name="inline_meta_after_relation">
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <rule pattern="(?&lt;!\.)\.{2}(?!\.)">
        <token type="CommentHashbang"/>
        <push state="inline_meta_object"/>
      </rule>
      <rule pattern="(?=\n)">
        <pop depth="1"/>
      </rule>
    </state>

    <!-- MetaObjectInline := TextExcept{NL,SC2} — stops at `;;`. -->
    <state name="inline_meta_object">
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <!-- `!!block?end=MARKER`: the terminator repeats text captured EARLIER, which
           no per-line rule can refer back to. Chroma compiles with regexp2, so the
           whole construct — opener, body and terminator — is matched by ONE regex
           using a backreference, and coloured with bygroups. -->
      <rule pattern="((?:(?:https?://)?ddot\.it/|!!)block)(\?end=)([^\t\p{Zs}\r\n\f\v]+)([\t\p{Zs}]*\n)((?:[^\n]*\n)*?)([\t\p{Zs}]*)(\3)([\t\p{Zs}]*)(?=\n|$)">
        <bygroups>
          <token type="KeywordPseudo"/>
          <token type="NameDecorator"/>
          <token type="NameLabel"/>
          <token type="Text"/>
          <token type="LiteralStringBacktick"/>
          <token type="Text"/>
          <token type="NameLabel"/>
          <token type="Text"/>
        </bygroups>
      </rule>
      <rule pattern="(?:(?:https?://)?ddot\.it/|!!)block[\t\p{Zs}]*(?=\n|$)">
        <token type="KeywordPseudo"/>
        <push state="verbatim"/>
      </rule>
      <rule pattern="[^\t\p{Zs}\r\n\f\v;][^\n;]*?(?=[\t\p{Zs}]*(?&lt;!;);;(?!;)|[\t\p{Zs}]*$|\n|$)">
        <token type="LiteralStringHeredoc"/>
        <push state="inline_meta_next"/>
      </rule>
      <rule pattern="(?=\n)">
        <pop depth="1"/>
      </rule>
    </state>

    <!-- `;;` divides the ENTRIES of one triple's inline meta. The next entry may be
         a pair OR a free-text note, so go to the `inline_meta` dispatcher —
         `inline_meta_op` would accept only the dotted forms. -->
    <state name="inline_meta_next">
      <rule pattern="[\t\p{Zs}]+">
        <token type="Text"/>
      </rule>
      <rule pattern="(?&lt;!;);;(?!;)">
        <token type="Punctuation"/>
        <push state="inline_meta"/>
      </rule>
      <rule pattern="(?=\n)">
        <pop depth="1"/>
      </rule>
    </state>
  </rules>
</lexer>
